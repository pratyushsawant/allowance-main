# --- Secrets: never commit ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Dependencies / build output ---
node_modules/
dist/

# --- Local data and run logs ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite-journal
backend/data/
backend/.smoke/

# --- OS noise ---
.DS_Store

# --- Frontend (frontend/ also has its own .gitignore) ---
dist-ssr/
*.local
*.log
npm-debug.log*

# --- Editors and local tooling (absolute local paths live here) ---
.vscode/*
!.vscode/extensions.json
.idea/
.claude/
