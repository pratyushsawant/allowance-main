# Allowance backend — Phase 0 smoke test. ARC TESTNET ONLY: never put mainnet keys or funds here.
#
# Fastest setup: `npm run keys:generate` copies this file to backend/.env (mode 600),
# fills in fresh testnet keys, and prints only the public addresses.
# backend/.env is gitignored. Never paste these values into chat, issues or commits.

# Buyer (the agent): EOA private key, 0x + 64 hex chars. Signs the one-time Gateway
# deposit and the offchain EIP-3009 payment authorizations. Must be an EOA (Gateway
# nanopayments reject smart-contract-account signatures).
BUYER_PRIVATE_KEY=

# Seller: only SELLER_ADDRESS is needed to receive payments. The key is kept so the
# seller's Gateway balance can be withdrawn later.
SELLER_PRIVATE_KEY=
SELLER_ADDRESS=

# A second seller that is deliberately NOT on the allowlist (the "blocked purchase" demo).
UNLISTED_SELLER_PRIVATE_KEY=
UNLISTED_SELLER_ADDRESS=

# API credentials (32+ chars each, different from each other). The agent token can browse and
# request purchases; only the operator token can approve, decline, freeze or unfreeze.
AGENT_API_TOKEN=
OPERATOR_API_TOKEN=

# Browser sessions (docs/VOICE_INTEGRATION.md). A person types an access code once;
# POST /api/sessions returns a short-lived token for that scope. The frontend never holds
# the static tokens above. The two codes must differ. SESSION_SECRET signs the tokens;
# rotating it logs everyone out.
SESSION_SECRET=
DEMO_ACCESS_CODE=
OPERATOR_ACCESS_CODE=
AGENT_SESSION_TTL_SECONDS=7200
OPERATOR_SESSION_TTL_SECONDS=3600

# ElevenLabs (you supply these; keys:generate does not). The API key stays on the server.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Optional regional API base, e.g. https://api.us.elevenlabs.io
ELEVENLABS_API_BASE=

# Chat assistant (Claude, server-side only; never in the frontend). Without the key, POST /api/chat
# answers 503 and nothing is bought. ANTHROPIC_MODEL defaults to claude-sonnet-5-5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Quicknode Streams: the Stream's webhook "Security token" (32+ chars). You copy it from the
# Quicknode dashboard; keys:generate does not create it. Without it /webhooks/quicknode answers 503.
QN_STREAM_SECURITY_TOKEN=

# Exact browser origins allowed to call /api/* (comma-separated, no paths).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Header a trusted proxy overwrites with the client's address, for per-client rate limits.
# Defaults to x-real-ip on Railway (its edge overwrites it on every request) and to none elsewhere,
# where the socket address is used. Only set it behind a proxy that overwrites the header.
CLIENT_IP_HEADER=

# --- Optional overrides ---
# Circle Gateway API. MUST be the testnet host: BatchFacilitatorClient defaults to the
# mainnet host (gateway-api.circle.com) when no URL is given; src/config.ts refuses it.
GATEWAY_API_URL=https://gateway-api-testnet.circle.com
# Arc Testnet RPC. Leave empty for https://rpc.testnet.arc.io (the SDK default host no longer resolves).
ARC_RPC_URL=
# Hours of recorded odds to keep (default 48, about 260 MB). Older rows are pruned hourly; if the disk
# is nearly full at startup, the database is compacted first (see src/retention.ts).
ODDS_RETENTION_HOURS=
# Local smoke-test seller (binds to 127.0.0.1 only).
SELLER_PORT=4021
# Price of the smoke-test resource, decimal USDC. Converted with the USDC decimals from the SDK chain config.
SMOKE_PRICE_USDC=0.005
# Authorization version the seller advertises: "2" binds the asset into the signature (salt); "1" is the documented default.
AUTH_VERSION=2
# Amount moved from the buyer wallet into its Gateway balance by `npm run smoke:deposit -- --yes`.
DEPOSIT_USDC=1

# --- Service (npm start) ---
HOST=127.0.0.1
PORT=8787
# Base URL the sellers advertise in their 402 offers. Must be how the buyer reaches this process.
# PUBLIC_BASE_URL=http://127.0.0.1:8787
# Set to 0 while a standalone `npm run recorder` is writing to the same database.
RECORDER_ENABLED=1
# DB_PATH=./data/allowance.db

# --- Spending policy (decimal USDC) ---
# Comma-separated payees the agent may pay. Defaults to SELLER_ADDRESS.
# ALLOWED_PAYEES=
AUTO_APPROVE_MAX_USDC=0.25
PER_CALL_MAX_USDC=1.00
DAILY_CAP_USDC=2.00
BUDGET_TIME_ZONE=America/Chicago
