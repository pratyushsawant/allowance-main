# Frontend build settings. Everything here ends up in the PUBLIC browser bundle:
# never put a secret, API key, private key or access code in a VITE_ variable.
# Copy to .env.local (gitignored) only if you need to override the defaults.

# Allowance backend base URL. Default: https://allowance-backend-production.up.railway.app
# Local backend example: http://127.0.0.1:8787 (its CORS_ALLOWED_ORIGINS must include this page's origin)
VITE_API_URL=

# 1 = offline demo with fake data and no backend (labelled "Demo data"). Leave empty for the real backend.
VITE_USE_MOCK=
